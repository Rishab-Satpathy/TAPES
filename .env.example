# TAPES — Provider Configuration
# Only watsonx (IBM Bob) is supported.
# TAPES works offline without any API keys for safe code analysis.

# ── Provider selection ─────────────────────────────────────────
AITAPES_PROVIDER=watsonx

# ── Universal connection settings ──────────────────────────────
AITAPES_API_BASE_URL=
AITAPES_API_KEY=
AITAPES_MODEL=
AITAPES_TOKEN_BUDGET=100000

# ── IBM watsonx (Bob) ───────────────────────────────────────────
# Set these environment variables or add them to your shell profile:
#   $env:AITAPES_PROVIDER="watsonx"
#   $env:IBM_BOB_API_KEY="<your-key>"
#   $env:IBM_BOB_PROJECT_ID="<project-id>"
IBM_BOB_API_KEY=
IBM_BOB_PROJECT_ID=
IBM_BOB_MODEL_ID=ibm/granite-13b-chat-v2
